<project name="JPack" default="dist" basedir=".">
  <description>
    Building JPack
  </description>

  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="dist" location="dist"/>

  <path id="dep.runtime">
    <fileset dir="./lib">
        <include name="*.jar" />
    </fileset>
  </path>

  <target name="init">
    <mkdir dir="${build}"/>
  </target>

  <target name="compile" depends="init"
        description="compile the source">
    <javac includeantruntime="false" srcdir="${src}" destdir="${build}" debug="true" debuglevel="lines,vars,source">
      <classpath>
	<fileset dir="lib">
          <include name="**/*.jar" />
        </fileset>
      </classpath>
    </javac>
  </target>

  <target name="dist" depends="compile" description="generate the distribution">
    <!-- the template compiler is bundled in, so JPack.jar runs on its own -->
    <jar jarfile="${dist}/JPack.jar">
      <fileset dir="${build}"/>
      <zipgroupfileset dir="lib" includes="vue3-template-compiler.jar"/>
      <manifest>
        <attribute name="Main-Class" value="jpack.Main"/>
      </manifest>
    </jar>
    <copy todir=".">
      <fileset file="${dist}/JPack.jar"/>
    </copy>
  </target>

  <target name="clean" description="clean up">
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
  </target>
</project>
